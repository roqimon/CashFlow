[Unit]
Description=ArusKas account and synchronization API
After=network.target postgresql.service

[Service]
Type=simple
User=cashflow
Group=cashflow
WorkingDirectory=/opt/cashflow-account
Environment=NODE_ENV=production
EnvironmentFile=/etc/cashflow-account.env
ExecStart=/usr/bin/node /opt/cashflow-account/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
